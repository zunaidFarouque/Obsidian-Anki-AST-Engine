{
  "name": "obsidian-anki-ast-engine",
  "version": "1.0.0",
  "description": "A deterministic, headless Node.js synchronization pipeline bridging Obsidian and Anki.",
  "homepage": "https://github.com/zunaidFarouque/Obsidian-Anki-AST-Engine",
  "main": "dist/index.js",
  "scripts": {
    "start": "bun run src/index.ts",
    "sync": "bun run src/index.ts",
    "build": "tsc",
    "dev": "bun run src/index.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:fixtures": "bun test tests/fixtures tests/parser tests/ast/transclusionGraft.test.ts tests/ast/mediaResolver.test.ts tests/io/frontmatterFilter.test.ts",
    "setup:fixtures": "bun run scripts/download-fixture-assets.ts",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zunaidFarouque/Obsidian-Anki-AST-Engine.git"
  },
  "keywords": [
    "obsidian",
    "anki",
    "ast",
    "markdown",
    "sync",
    "remark",
    "unified",
    "flashcards",
    "spaced-repetition"
  ],
  "author": "zunaidFarouque",
  "license": "MIT",
  "dependencies": {
    "async-mutex": "^0.4.0",
    "fast-glob": "^3.3.2",
    "p-limit": "^5.0.0",
    "rehype-mathjax": "^7.1.0",
    "rehype-stringify": "^10.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.0.0",
    "remark-wiki-link": "^2.0.1",
    "unified": "^11.0.4",
    "unist-util-is": "^6.0.0",
    "unist-util-visit": "^5.0.0",
    "unist-util-visit-parents": "^6.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "bun-types": "^1.2.0",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3"
  }
}
