{
	"name": "anki-ast-sync",
	"version": "0.2.0",
	"description": "Obsidian plugin for the Obsidian-Anki AST sync engine",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json ../manifest.json",
		"lint": "eslint ."
	},
	"keywords": [
		"obsidian",
		"anki",
		"sync",
		"flashcards"
	],
	"license": "MIT",
	"devDependencies": {
		"@codemirror/state": "^6.5.2",
		"@codemirror/view": "^6.38.2",
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	},
	"overrides": {
		"minimatch": "^9.0.6",
		"brace-expansion": "^2.1.2",
		"js-yaml": "^4.3.2"
	}
}
